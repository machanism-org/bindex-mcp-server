' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml BindexMcpServerComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Bindex MCP Server — Component View

LAYOUT_LEFT_RIGHT()

Person(mcpClient, "MCP-compatible client", "AI assistant, IDE, or automation that invokes Bindex tools.")
System_Ext(projectWorkspace, "Project workspace", "Project directory containing Bindex JSON files.")
System_Ext(remoteBindexSource, "Remote Bindex source", "HTTP(S) location hosting a Bindex JSON document.")
System_Ext(mongoDb, "Bindex repository (MongoDB)", "Persists Bindex metadata and supports vector search.")
System_Ext(genAiService, "GenAI and embedding service", "Generates classifications and embeddings for semantic discovery.")

Container_Boundary(bindexServer, "Bindex MCP Server executable (Java 17)") {
    Component(mcpRuntime, "MCP server runtime", "machai-mcp-server", "Discovers tools, routes MCP requests, and provides STDIO or HTTP transport.")
    Component(bindexTools, "Bindex MCP tools", "bindex-core", "Exposes metadata retrieval, registration, and library recommendation operations.")
    Component(bindexServices, "Bindex metadata and discovery", "bindex-core", "Validates and normalizes descriptors, classifies requests, generates embeddings, and coordinates repository operations.")
}

note right of bindexServer
    This distribution module has no src/main/java directory.
    The components shown are supplied by its declared dependencies;
    no local Java implementation components are omitted from the view.
end note

Rel(mcpClient, mcpRuntime, "Invokes Bindex tools", "MCP over STDIO or HTTP (/mcp)")
Rel(mcpRuntime, bindexTools, "Dispatches tool requests", "In-process")
Rel(bindexTools, bindexServices, "Requests metadata and discovery operations", "In-process")
Rel(bindexServices, projectWorkspace, "Reads project-local Bindex JSON files", "File system")
Rel(bindexServices, remoteBindexSource, "Retrieves Bindex JSON documents", "HTTP(S)")
Rel(bindexServices, mongoDb, "Loads, saves, and searches metadata", "MongoDB")
Rel(bindexServices, genAiService, "Requests classifications and embeddings", "Configured GenAI API")

SHOW_LEGEND()
@enduml

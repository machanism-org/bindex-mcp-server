' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml BindexMcpServerComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Bindex MCP Server — Component Diagram

LAYOUT_LEFT_RIGHT()

Person(mcpClient, "MCP-compatible client", "AI assistant, IDE, or automation that invokes Bindex tools.")
System_Ext(projectWorkspace, "Project workspace", "Project directory containing Bindex JSON files.")
System_Ext(remoteBindexSource, "Remote Bindex source", "HTTP(S) location hosting a Bindex JSON document.")
System_Ext(mongoDb, "Bindex repository (MongoDB)", "Persists Bindex metadata and supports vector search.")
System_Ext(genAiService, "GenAI and embedding service", "Generates classifications and embeddings for semantic discovery.")

System_Boundary(bindexServer, "Bindex MCP Server") {
    Container_Boundary(serverApplication, "Executable Java 17 application") {
        Component(mcpRuntime, "Machai MCP Server runtime", "Java 17; STDIO or HTTP", "Hosts MCP transport, accepts client requests, and publishes the available tools.")
        Component(toolAdapter, "Bindex MCP tools", "MCP tool callbacks", "Exposes get-bindex, register-bindex, register-bindex-json, and pick-libraries, and delegates each request to Bindex Core.")
        Component(metadataOperations, "Bindex Core metadata operations", "Bindex Core", "Retrieves metadata and schema, and validates, normalizes, and registers Bindex records.")
        Component(recommendationOperations, "Bindex Core recommendation operations", "Bindex Core", "Classifies requirements, performs semantic search, and applies relevance and version-aware filters.")
    }
}

Rel(mcpClient, mcpRuntime, "Invokes Bindex operations", "MCP over STDIO or HTTP (/mcp)")
Rel(mcpRuntime, toolAdapter, "Dispatches tool calls")
Rel(toolAdapter, metadataOperations, "Retrieves metadata, serves schema, and registers records")
Rel(toolAdapter, recommendationOperations, "Finds recommended libraries")
Rel(metadataOperations, projectWorkspace, "Reads Bindex JSON files", "File system")
Rel(metadataOperations, remoteBindexSource, "Retrieves Bindex JSON documents", "HTTP(S)")
Rel(metadataOperations, mongoDb, "Loads and saves Bindex metadata", "MongoDB")
Rel(recommendationOperations, mongoDb, "Performs vector and metadata searches", "MongoDB")
Rel(recommendationOperations, genAiService, "Requests classifications and embeddings", "Configured GenAI API")

SHOW_LEGEND()
@enduml
